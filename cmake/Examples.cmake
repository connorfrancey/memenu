# The example macros (examples/replays/*.json and *.merp) as byte arrays in a generated .cpp (src/tas/examples.h),
# so every way of installing the menu (installer, launcher, dev-test) gets them: tas::Init() writes the ones the
# replays/ folder hasn't had yet. Regenerated whenever an example changes (they are configure dependencies).

function(memenu_embed_examples out_var)
  file(GLOB _examples CONFIGURE_DEPENDS
      ${PROJECT_SOURCE_DIR}/examples/replays/*.json
      ${PROJECT_SOURCE_DIR}/examples/replays/*.merp)
  list(SORT _examples)

  set(_arrays "")
  set(_entries "")
  set(_i 0)
  foreach(file IN LISTS _examples)
    get_filename_component(_name "${file}" NAME)
    file(READ "${file}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f])"
           "\\1\n    " _bytes "${_bytes}")
    string(APPEND _arrays "const unsigned char kData${_i}[] = {\n    ${_bytes}0};\n")
    string(APPEND _entries "    {\"${_name}\", kData${_i}, ${_size}},\n")
    math(EXPR _i "${_i} + 1")
  endforeach()
  if(_i EQUAL 0)
    set(_entries "    {nullptr, nullptr, 0},\n")
  endif()

  set(_out "${CMAKE_BINARY_DIR}/generated/memenu_examples.cpp")
  set(_content "// Generated by cmake/Examples.cmake from examples/replays/: do not edit.
#include \"tas/examples.h\"

namespace tas::examples {
namespace {
${_arrays}const File kAll[] = {
${_entries}};
} // namespace

const File* begin() { return kAll; }
const File* end() { return kAll + ${_i}; }

} // namespace tas::examples
")
  # Only rewritten when it changed, so a reconfigure doesn't rebuild it
  if(EXISTS "${_out}")
    file(READ "${_out}" _old)
  endif()
  if(NOT "${_old}" STREQUAL "${_content}")
    file(WRITE "${_out}" "${_content}")
  endif()
  set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
