# Build identity stamped into the DLL and written at the top of every log (see the log format in src/log.cpp), so a
# log can be matched to the exact build that wrote it.
#
# Included from CMakeLists.txt: memenu_add_build_info(<target>) adds a generated build_info.cpp to <target> and
# regenerates it on every build. Run as a script (cmake -P) by that custom command.
#
#   build number  increases by one on every build (counter in <repo>/build/.build-number, shared by all build folders;
#                 CI sets MEMENU_BUILD_NUMBER, e.g. to the workflow run number)
#   id            random UUID, new on every build
#   magic         64-bit hash (first 16 hex digits of SHA-256) of the build's details: version, commit, config,
#                 compiler, options and features. Same magic = same code built the same way; the details themselves
#                 are in the log header and in build_info::kDetails.

if(CMAKE_SCRIPT_MODE_FILE)
  string(TIMESTAMP _now "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(RANDOM LENGTH 32 _salt)
  string(UUID _id NAMESPACE "6ba7b810-9dad-11d1-80b4-00c04fd430c8" NAME "${_salt}${_now}" TYPE SHA1)

  # Build number
  if(DEFINED ENV{MEMENU_BUILD_NUMBER} AND NOT "$ENV{MEMENU_BUILD_NUMBER}" STREQUAL "")
    set(_number "$ENV{MEMENU_BUILD_NUMBER}")
  else()
    set(_number 0)
    if(EXISTS "${NUMBER_FILE}")
      file(READ "${NUMBER_FILE}" _number)
      string(STRIP "${_number}" _number)
      if(NOT _number MATCHES "^[0-9]+$")
        set(_number 0)
      endif()
    endif()
    math(EXPR _number "${_number} + 1")
    file(WRITE "${NUMBER_FILE}" "${_number}\n")
  endif()

  # Commit
  set(_git "unknown")
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=10 HEAD
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE _hash
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rc)
    if(_rc EQUAL 0 AND _hash)
      set(_git "${_hash}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
                      WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE _dirty ERROR_QUIET)
      if(_dirty)
        string(APPEND _git "-dirty")
      endif()
    endif()
  endif()

  # The details the magic is computed from: "key=value" lines, in this order
  string(REPLACE "," " " _features "${FEATURES}")
  string(REPLACE "," " " _options "${OPTIONS}")
  if(_features STREQUAL "")
    set(_features "(none)")
  endif()
  set(_details "version=${VERSION}\ncommit=${_git}\nconfig=${CONFIG}\ncompiler=${COMPILER}\noptions=${_options}\nfeatures=${_features}")
  string(SHA256 _sha "${_details}")
  string(SUBSTRING "${_sha}" 0 16 _magic)
  string(TOUPPER "${_magic}" _magic)

  string(REPLACE "\n" "\\n" _details_c "${_details}")
  file(WRITE "${OUTPUT}" "// Generated by cmake/BuildInfo.cmake on every build. Do not edit.
#include \"build_info.h\"

const unsigned build_info::kNumber              = ${_number};
const unsigned long long build_info::kMagic     = 0x${_magic}ULL;
const char* const build_info::kMagicHex         = \"${_magic}\";
const char* const build_info::kId               = \"${_id}\";
const char* const build_info::kVersion          = \"${VERSION}\";
const char* const build_info::kGitCommit        = \"${_git}\";
const char* const build_info::kTimestamp        = \"${_now}\";
const char* const build_info::kConfig           = \"${CONFIG}\";
const char* const build_info::kCompiler         = \"${COMPILER}\";
const char* const build_info::kOptions          = \"${_options}\";
const char* const build_info::kFeatures         = \"${_features}\";
const char* const build_info::kDetails          = \"${_details_c}\";
")
  return()
endif()

function(memenu_add_build_info target)
  set(_out "${CMAKE_BINARY_DIR}/generated/build_info.cpp")
  string(JOIN "," _features ${MEMENU_ENABLED_FEATURES})
  set(_options "game=$<BOOL:${MEMENU_GAME}>,optimizations=$<BOOL:${MEMENU_OPTIMIZATIONS}>,minimal=$<BOOL:${MEMENU_BARE}>")
  if(MEMENU_MINIMAL)
    string(APPEND _options ",stage=${MEMENU_STAGE}")
  endif()
  add_custom_target(${target}_build_info ALL
    COMMAND ${CMAKE_COMMAND}
            -DOUTPUT=${_out} -DVERSION=${MEMENU_VERSION} -DSOURCE_DIR=${PROJECT_SOURCE_DIR}
            -DNUMBER_FILE=${PROJECT_SOURCE_DIR}/build/.build-number -DCONFIG=$<CONFIG>
            "-DCOMPILER=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}"
            -DFEATURES=${_features} -DOPTIONS=${_options}
            -P ${PROJECT_SOURCE_DIR}/cmake/BuildInfo.cmake
    BYPRODUCTS ${_out}
    COMMENT "Generating build identity"
    VERBATIM)
  target_sources(${target} PRIVATE ${_out})
  source_group("Generated" FILES ${_out})
  add_dependencies(${target} ${target}_build_info)
endfunction()
