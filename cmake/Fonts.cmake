# The menu's fonts as byte arrays in a generated .cpp (src/font.h), so nothing has to be installed next to the DLL.
# Both come with Dear ImGui (misc/fonts), Apache License 2.0:
#   Roboto Medium     the menu
#   Cousine Regular   monospace: the console (features/misc/console.cpp)
# A font that isn't there is empty in the generated file: ImGui's built-in font is used in its place.

# The C array `name` with the bytes of `file`, and its size, into `data_var` / `size_var`
function(_memenu_font_array file name label data_var size_var)
  if(EXISTS "${file}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # 32 bytes per line: one line of 160 KB would be hard on editors and the compiler
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],){4})"
           "\\1\n    " _bytes "${_bytes}")
    set(${data_var} "const unsigned char ${name}[] = {\n    ${_bytes}0};\n" PARENT_SCOPE)
    set(${size_var} "${_size}" PARENT_SCOPE)
    message(STATUS "Font: ${label} (${_size} bytes)")
  else()
    set(${data_var} "const unsigned char ${name}[] = {0};\n" PARENT_SCOPE)
    set(${size_var} "0" PARENT_SCOPE)
    message(STATUS "Font: ${file} not found, ImGui's built-in font is used for it")
  endif()
endfunction()

function(memenu_embed_font out_var)
  set(_out "${CMAKE_BINARY_DIR}/generated/memenu_font.cpp")
  _memenu_font_array("${imgui_SOURCE_DIR}/misc/fonts/Roboto-Medium.ttf" kMenu "Roboto Medium" _menu _menuSize)
  _memenu_font_array("${imgui_SOURCE_DIR}/misc/fonts/Cousine-Regular.ttf" kMono "Cousine Regular" _mono _monoSize)

  set(_content "// Generated by cmake/Fonts.cmake: do not edit.
#include \"font.h\"

namespace font {
namespace {
${_menu}
${_mono}} // namespace

const unsigned char* MenuData() { return kMenu; }
std::size_t MenuSize() { return ${_menuSize}; }
const unsigned char* MonoData() { return kMono; }
std::size_t MonoSize() { return ${_monoSize}; }

} // namespace font
")
  # Only rewritten when it changed, so a reconfigure doesn't rebuild it
  if(EXISTS "${_out}")
    file(READ "${_out}" _old)
  endif()
  if(NOT "${_old}" STREQUAL "${_content}")
    file(WRITE "${_out}" "${_content}")
  endif()
  set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
