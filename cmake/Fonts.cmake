# The menu's font as a byte array in a generated .cpp (src/font.h), so nothing has to be installed next to the DLL.
# Roboto Medium (Apache License 2.0) comes with Dear ImGui (misc/fonts). Without it the generated file is empty and the
# menu keeps ImGui's built-in font.

function(memenu_embed_font out_var)
  set(_font "${imgui_SOURCE_DIR}/misc/fonts/Roboto-Medium.ttf")
  set(_out "${CMAKE_BINARY_DIR}/generated/memenu_font.cpp")

  if(EXISTS "${_font}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_font}")
    file(READ "${_font}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # 32 bytes per line: one line of 160 KB would be hard on editors and the compiler
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],){4})"
           "\\1\n    " _bytes "${_bytes}")
    set(_data "const unsigned char kData[] = {\n    ${_bytes}0};\n")
    set(_sizeExpr "${_size}")
    message(STATUS "Menu font: Roboto Medium (${_size} bytes)")
  else()
    set(_data "const unsigned char kData[] = {0};\n")
    set(_sizeExpr "0")
    message(STATUS "Menu font: ${_font} not found, the menu uses ImGui's built-in font")
  endif()

  set(_content "// Generated by cmake/Fonts.cmake: do not edit.
#include \"font.h\"

namespace font {
namespace {
${_data}} // namespace

const unsigned char* MenuData() { return kData; }
std::size_t MenuSize() { return ${_sizeExpr}; }

} // namespace font
")
  # Only rewritten when it changed, so a reconfigure doesn't rebuild it
  if(EXISTS "${_out}")
    file(READ "${_out}" _old)
  endif()
  if(NOT "${_old}" STREQUAL "${_content}")
    file(WRITE "${_out}" "${_content}")
  endif()
  set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
