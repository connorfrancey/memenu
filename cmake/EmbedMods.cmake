# Embeds the first-party mods (mods/<id>/...) into the menu's DLL: writes OUT, a C++ file with every file under ROOT as
# a byte array, for runtime/firstparty.cpp to write out at startup. Run at build time (cmake -P), whenever one changes.
#   cmake -DROOT=<repo>/mods -DOUT=<build>/generated/firstparty_mods.cpp -P cmake/EmbedMods.cmake
file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/*")
list(SORT files)
set(arrays "")
set(entries "")
set(i 0)
foreach(f IN LISTS files)
    file(READ "${ROOT}/${f}" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR bytes "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," data "${hex}")
    string(APPEND arrays "static const unsigned char kData${i}[] = {${data}0};\n")
    string(APPEND entries "\t{\"${f}\", kData${i}, ${bytes}},\n")
    math(EXPR i "${i} + 1")
endforeach()
set(text "// Generated by cmake/EmbedMods.cmake from mods/: do not edit.\n#include \"runtime/firstparty.h\"\n\nnamespace\n{\n${arrays}\nconst mirage::firstparty::File kFiles[] = {\n${entries}\t{nullptr, nullptr, 0},\n};\n}\n\nstd::span<const mirage::firstparty::File> mirage::firstparty::Files() { return {kFiles, ${i}}; }\n")
file(WRITE "${OUT}.tmp" "${text}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
